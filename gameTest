local function getBondCount()
    local bondInfo = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("BondGui")
    if bondInfo then
        local bondCount = bondInfo:FindFirstChild("BondInfo")
        if bondCount then
            local content = bondCount:FindFirstChild("BondCount")
            if content then
                local text = content:FindFirstChild("ContentText")
                if text then
                    return tonumber(text.Text) or 0
                end
            end
        end
    end
    return 0
end

local execCount = 0
local filePath = "auto_bounds_execution_logs.txt"
local success, data = pcall(function()
    return readfile(filePath)
end)
if success then
    execCount = tonumber(data) or 0
end
execCount = execCount + 1
pcall(function()
    writefile(filePath, tostring(execCount))
end)
execLabel.Text = "Total executions: " .. execCount

