local function getBondCount()
    local bondGui = player.PlayerGui:FindFirstChild("BondGui")
    if bondGui then
        local bondInfo = bondGui:FindFirstChild("BondInfo")
        if bondInfo then
            local bondCount = bondInfo:FindFirstChild("BondCount")
            if bondCount then
                if bondCount:IsA("TextLabel") then
                    local text = bondCount.Text
                    local num = tonumber(text:match("%d+"))
                    return num or 0
                end
            end
        end
    end
    return 0
end

local execCount = 0
local filePath = "auto_bounds_execution_logs.txt"
